# Weather Circles — build, screenshot and ship.
#
# Auth is an App Store Connect API key rather than an Apple ID: it needs no
# 2FA prompt, and it's what lets `review_status` read anything back from
# ASC at all. Point these at the key generated in App Store Connect
# (Users and Access → Integrations → App Store Connect API):
#
#   export ASC_KEY_ID=XXXXXXXXXX
#   export ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
#   export ASC_KEY_PATH=~/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8
#
# Keep the .p8 outside the repo. It downloads exactly once and can't be
# re-fetched afterwards, only regenerated.

default_platform(:ios)

SCHEME = "WeatherCircles"
PROJECT = "WeatherCircles.xcodeproj"

platform :ios do
  # ── Screenshots ──────────────────────────────────────────────────────

  desc "Capture the App Store screenshot set on every device class"
  lane :screenshots do
    ensure_screenshot_simulators
    capture_ios_screenshots
    UI.success("Screenshots in fastlane/screenshots — look at them before uploading.")
  end

  desc "Upload fastlane/screenshots to App Store Connect"
  lane :upload_screenshots do
    upload_to_app_store(
      api_key: asc_api_key,
      skip_binary_upload: true,
      skip_metadata: true,
      overwrite_screenshots: true,
      submit_for_review: false,        # screenshots alone shouldn't start a review
      precheck_include_in_app_purchases: false,
      force: true                      # no HTML summary to confirm in a terminal
    )
  end

  # ── Builds ───────────────────────────────────────────────────────────

  desc "Archive and upload a build to TestFlight"
  lane :beta do |options|
    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      xcargs: "-allowProvisioningUpdates"
    )
    upload_to_testflight(
      api_key: asc_api_key,
      changelog: options[:changelog] || changelog_text,
      skip_waiting_for_build_processing: true    # return once ASC accepts it
    )
  end

  desc "Prepare (but never submit) an App Store version: What's New + the build"
  lane :prepare_release do |options|
    version_string = options[:version] ||
                     get_version_number(xcodeproj: PROJECT, target: SCHEME)
    build_string = options[:build] ||
                   get_build_number(xcodeproj: PROJECT)
    notes = options[:changelog] || changelog_text
    UI.user_error!("No changelog — write fastlane/changelog.txt") if notes.to_s.empty?

    key = asc_api_key
    Spaceship::ConnectAPI.auth(key_id: key[:key_id], issuer_id: key[:issuer_id],
                               key: key[:key], in_house: false)
    identifier = CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
    app = Spaceship::ConnectAPI::App.find(identifier)
    UI.user_error!("No app in ASC for #{identifier}") if app.nil?

    version = app.get_edit_app_store_version
    if version.nil?
      UI.message("Creating App Store version #{version_string}")
      version = app.create_version!(version_string: version_string,
                                    platform: Spaceship::ConnectAPI::Platform::IOS)
    elsif version.version_string != version_string
      UI.user_error!("ASC is already preparing #{version.version_string}, not #{version_string}")
    end

    version.get_app_store_version_localizations.each do |localization|
      next unless localization.locale == "en-US"
      localization.update(attributes: { whats_new: notes })
      UI.success("What's New set for #{localization.locale}")
    end

    # A build can only be attached once ASC has finished processing it,
    # which runs for a few minutes after the upload returns.
    build = wait_for_build(app: app, version_string: version_string,
                           build_string: build_string)
    if build
      version.select_build(build_id: build.id)
      UI.success("Attached build #{build_string} to #{version_string}")
    end

    UI.important("#{version_string} is prepared and NOT submitted — " \
                 "submit it yourself in App Store Connect.")
  end

  # ── Read-only ────────────────────────────────────────────────────────

  desc "What does App Store Connect think the current state is?"
  lane :review_status do
    key = asc_api_key
    Spaceship::ConnectAPI.auth(key_id: key[:key_id], issuer_id: key[:issuer_id],
                               key: key[:key], in_house: false)

    identifier = CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
    app = Spaceship::ConnectAPI::App.find(identifier)
    UI.user_error!("No app in ASC for #{identifier}") if app.nil?
    UI.message("#{app.name} (#{app.bundle_id})")

    live = app.get_live_app_store_version
    UI.success("Live: #{live.version_string} (build #{live.build&.version})") if live

    edit = app.get_edit_app_store_version
    if edit
      UI.important("In flight: #{edit.version_string} — #{edit.app_store_state}")
      UI.important("  build: #{edit.build&.version || 'none attached yet'}")
    else
      UI.message("Nothing currently being prepared for release.")
    end

    UI.message("Recent builds:")
    app.get_builds(includes: "preReleaseVersion", limit: 5).each do |build|
      UI.message("  #{build.pre_release_version&.version} (#{build.version}) — #{build.processing_state}")
    end
  end

  # ── Helpers ──────────────────────────────────────────────────────────

  # One changelog, used for both the TestFlight "What to Test" note and the
  # App Store "What's New" — they describe the same build, and keeping two
  # copies is how they end up disagreeing.
  private_lane :changelog_text do
    path = File.expand_path("changelog.txt", File.dirname(__FILE__))
    File.exist?(path) ? File.read(path).strip : nil
  end

  # ASC accepts an upload long before the build is usable: it has to finish
  # processing first, and only then can a version select it.
  private_lane :wait_for_build do |options|
    app = options[:app]
    deadline = Time.now + 25 * 60
    loop do
      build = app.get_builds(includes: "preReleaseVersion", limit: 20).find do |candidate|
        candidate.pre_release_version&.version == options[:version_string] &&
          candidate.version == options[:build_string]
      end
      if build.nil?
        UI.message("Build #{options[:build_string]} isn't in ASC yet…")
      elsif build.processing_state == "VALID"
        break build
      else
        UI.message("Build #{options[:build_string]} is #{build.processing_state}…")
      end
      if Time.now > deadline
        UI.important("Gave up waiting for build #{options[:build_string]} to process. " \
                     "Re-run `fastlane prepare_release` later to attach it.")
        break nil
      end
      sleep(60)
    end
  end

  private_lane :asc_api_key do
    %w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_PATH].each do |var|
      UI.user_error!("#{var} isn't set — see the comment at the top of the Fastfile") if ENV[var].to_s.empty?
    end
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: File.expand_path(ENV["ASC_KEY_PATH"]),
      in_house: false
    )
  end

  # snapshot matches devices by name against simulators that already exist
  # and errors out rather than creating them, so make any missing ones on
  # the newest installed runtime.
  private_lane :ensure_screenshot_simulators do
    wanted = ["iPhone 14 Plus", "iPhone 17 Pro Max", "iPad Pro 13-inch (M5)"]
    existing = `xcrun simctl list devices`.scan(/^\s{4}(.+?) \(/).flatten
    runtime = `xcrun simctl list runtimes`
              .scan(/(com\.apple\.CoreSimulator\.SimRuntime\.iOS-[\d-]+)/).flatten.last
    UI.user_error!("No iOS simulator runtime installed") if runtime.nil?

    wanted.each do |name|
      next if existing.include?(name)
      line = `xcrun simctl list devicetypes`.lines.find { |l| l.include?("#{name} (com.apple") }
      UI.user_error!("No simulator device type called '#{name}'") if line.nil?
      identifier = line[/\((com\.apple\.CoreSimulator\.SimDeviceType\.[^)]+)\)/, 1]
      UI.message("Creating simulator '#{name}'")
      sh("xcrun simctl create '#{name}' #{identifier} #{runtime}", log: false)
    end
  end
end
