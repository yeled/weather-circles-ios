.DS_Store
xcuserdata/
*.xcuserstate
DerivedData/
build/
*.xcresult

# fastlane. Screenshots are regenerated by `fastlane screenshots` and
# uploaded from there — a dozen 2-3 MB PNGs per run doesn't belong in git.
# docs/screenshot.png (the README one) is committed, deliberately.
fastlane/screenshots/
fastlane/test_output/
fastlane/report.xml
fastlane/README.md
*.p8

# fastlane comes from Homebrew here, not bundler — `fastlane init` drops a
# Gemfile in if it's ever re-run, and committing it would only bring back
# the "you didn't use bundle exec" warning on every invocation.
Gemfile
Gemfile.lock
